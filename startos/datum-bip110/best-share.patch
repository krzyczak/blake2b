+		"chains"), history_chain_id), "blocks")) == 2);
+	json_decref(persisted);
+	json_decref(block);
+	json_decref(history_root);
+	history_root = history_chain = NULL;
+	history_chain_id[0] = 0;
+	history_loaded = false;
+	memcpy(datum_config.mining_history_file, saved_path, sizeof(saved_path));
+	unlink(path);
+}
