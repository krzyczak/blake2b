+static json_t *datum_api_json_u64(uint64_t value) {
+	if (value <= INT64_MAX) return json_integer((json_int_t)value);
+	return json_real((double)value);
+}
+
+static int datum_api_best_shares(struct MHD_Connection *connection) {
+	json_t *root = json_object();
+	json_t *clients = json_array();
+	char client_id[32];
+
+	if (!root || !clients) {
+		json_decref(root);
+		json_decref(clients);
+		return datum_api_do_error(connection, MHD_HTTP_INTERNAL_SERVER_ERROR);
+	}
+
+	json_object_set_new(root, "global_best", datum_api_json_u64(
+		__atomic_load_n(&stratum_client_best_share_diff, __ATOMIC_RELAXED)));
+	json_object_set_new(root, "clients", clients);
+
+	if (global_stratum_app) {
+		for (int tid = 0; tid < global_stratum_app->max_threads; ++tid) {
+			for (int cid = 0; cid < global_stratum_app->max_clients_thread; ++cid) {
+				T_DATUM_CLIENT_DATA *client = &global_stratum_app->datum_threads[tid].client_data[cid];
+				if (client->fd <= 0) continue;
+
+				T_DATUM_MINER_DATA *m = client->app_client_data;
+				json_t *item = json_object();
+				if (!item) continue;
+
+				snprintf(client_id, sizeof(client_id), "%d/%d", tid, cid);
+				json_object_set_new(item, "id", json_string(client_id));
+				json_object_set_new(item, "remote_host", json_string(client->rem_host));
+				json_object_set_new(item, "username", json_string(m->last_auth_username));
+				json_object_set_new(item, "useragent", json_string(m->useragent));
+				json_object_set_new(item, "subscribed", json_boolean(m->subscribed));
+				json_object_set_new(item, "best_share", datum_api_json_u64(
+					__atomic_load_n(&m->best_share_diff, __ATOMIC_RELAXED)));
+				json_object_set_new(item, "accepted", datum_api_json_u64(m->share_count_accepted));
+				json_object_set_new(item, "accepted_diff", datum_api_json_u64(m->share_diff_accepted));
+				json_array_append_new(clients, item);
+			}
+		}
+	}
+
+	char *output = json_dumps(root, JSON_COMPACT);
+	json_decref(root);
+	if (!output) return datum_api_do_error(connection, MHD_HTTP_INTERNAL_SERVER_ERROR);
+
+	struct MHD_Response *response = MHD_create_response_from_buffer(strlen(output), output, MHD_RESPMEM_MUST_FREE);
+	if (!response) {
+		free(output);
+		return MHD_NO;
+	}
+	MHD_add_response_header(response, "Content-Type", "application/json");
+	return datum_api_submit_uncached_response(connection, MHD_HTTP_OK, response);
+}
