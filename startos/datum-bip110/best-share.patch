new file mode 100644
index 0000000..1f56a81
--- /dev/null
+++ b/src/datum_mining_history.c
@@ -0,0 +1,643 @@
+/*
+ * DATUM Gateway persistent mining history.
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <jansson.h>
+
+#include "datum_conf.h"
+#include "datum_jsonrpc.h"
+#include "datum_logger.h"
+#include "datum_mining_history.h"
+
+#define DATUM_MINING_HISTORY_SCHEMA_VERSION 1
+
+static pthread_mutex_t history_lock = PTHREAD_MUTEX_INITIALIZER;
+static json_t *history_root;
+static json_t *history_chain;
+static char history_chain_id[160];
+static bool history_loaded;
+
+static json_t *history_json_u64(const uint64_t value) {
+	if (value <= INT64_MAX) return json_integer((json_int_t)value);
+	return json_real((double)value);
+}
+
+static uint64_t history_json_get_u64(json_t *value) {
+	if (json_is_integer(value)) {
+		const json_int_t number = json_integer_value(value);
+		return number > 0 ? (uint64_t)number : 0;
+	}
+	if (json_is_real(value)) {
+		const double number = json_real_value(value);
+		if (number >= (double)UINT64_MAX) return UINT64_MAX;
+		return number > 0 ? (uint64_t)number : 0;
+	}
+	return 0;
+}
+
+static char *history_timestamp(const uint64_t unix_time, char output[32]) {
+	time_t raw = (time_t)unix_time;
+	struct tm utc;
+
+	if (!gmtime_r(&raw, &utc)) {
+		output[0] = 0;
+		return output;
+	}
+	strftime(output, 32, "%Y-%m-%dT%H:%M:%SZ", &utc);
+	return output;
+}
+
+static void history_hash_hex(const uint8_t hash[32], char output[65]) {
+	static const char digits[] = "0123456789abcdef";
+	int i;
+
+	for (i = 0; i < 32; ++i) {
+		const uint8_t byte = hash[31 - i];
+		output[i * 2] = digits[byte >> 4];
+		output[(i * 2) + 1] = digits[byte & 0x0f];
+	}
+	output[64] = 0;
+}
+
+static json_t *history_new_root(void) {
+	json_t *root = json_object();
+	if (!root) return NULL;
+	json_object_set_new(root, "schema_version", json_integer(DATUM_MINING_HISTORY_SCHEMA_VERSION));
+	json_object_set_new(root, "active_chain_id", json_null());
+	json_object_set_new(root, "chains", json_object());
+	return root;
+}
+
+static void history_load_locked(void) {
+	json_error_t error;
+	json_t *chains;
+
+	if (history_loaded) return;
+	history_loaded = true;
+
+	if (datum_config.mining_history_file[0]) {
+		history_root = json_load_file(datum_config.mining_history_file, 0, &error);
+		if (!history_root && errno != ENOENT) {
+			DLOG_ERROR(
+				"Could not read mining history %s: %s (line %d)",
+				datum_config.mining_history_file,
+				error.text,
+				error.line
+			);
+		}
+	}
+
+	if (!json_is_object(history_root)) {
+		json_decref(history_root);
+		history_root = history_new_root();
+	}
+	if (!history_root) return;
+
+	chains = json_object_get(history_root, "chains");
+	if (!json_is_object(chains)) {
+		json_object_set_new(history_root, "chains", json_object());
+	}
+	json_object_set_new(
+		history_root,
+		"schema_version",
+		json_integer(DATUM_MINING_HISTORY_SCHEMA_VERSION)
+	);
+}
+
+static bool history_write_locked(void) {
+	char temporary_path[sizeof(datum_config.mining_history_file) + 8];
+	char timestamp[32];
+	FILE *file;
+	bool success = false;
+
+	if (!history_root || !datum_config.mining_history_file[0]) return false;
+	if (snprintf(
+		temporary_path,
+		sizeof(temporary_path),
+		"%s.tmp",
+		datum_config.mining_history_file
+	) >= (int)sizeof(temporary_path)) {
+		DLOG_ERROR("Mining history path is too long");
+		return false;
+	}
+
+	json_object_set_new(
+		history_root,
+		"updated_at",
+		json_string(history_timestamp((uint64_t)time(NULL), timestamp))
+	);
+	file = fopen(temporary_path, "w");
+	if (!file) {
+		DLOG_ERROR("Could not open mining history temporary file: %s", strerror(errno));
+		return false;
+	}
+
+	if (json_dumpf(history_root, file, JSON_INDENT(2) | JSON_SORT_KEYS) != 0 ||
+	    fputc('\n', file) == EOF || fflush(file) != 0 || fsync(fileno(file)) != 0) {
+		DLOG_ERROR("Could not write mining history: %s", strerror(errno));
+	} else if (fclose(file) != 0) {
+		file = NULL;
+		DLOG_ERROR("Could not close mining history: %s", strerror(errno));
+	} else {
+		file = NULL;
+		if (rename(temporary_path, datum_config.mining_history_file) == 0) {
+			success = true;
+		} else {
+			DLOG_ERROR("Could not replace mining history: %s", strerror(errno));
+		}
+	}
+
+	if (file) fclose(file);
+	if (!success) remove(temporary_path);
+	return success;
+}
+
+static const char *history_explorer_template(const char *network) {
+	if (!strcmp(network, "main")) return "https://mempool.guide/block/{hash}";
+	if (!strcmp(network, "testnet4")) return "https://mempool.guide/testnet4/block/{hash}";
+	if (!strcmp(network, "test")) return "https://mempool.guide/testnet/block/{hash}";
+	if (!strcmp(network, "signet")) return "https://mempool.guide/signet/block/{hash}";
+	return NULL;
+}
+
+static json_t *history_default_share(const char *scope) {
+	json_t *share = json_object();
+	if (!share) return NULL;
+	json_object_set_new(share, "difficulty", json_null());
+	json_object_set_new(share, "share_hash", json_null());
+	json_object_set_new(share, "observed_at", json_null());
+	if (scope) json_object_set_new(share, "scope", json_string(scope));
+	json_object_set_new(share, "complete", json_false());
+	return share;
+}
+
+static json_t *history_create_chain(
+	const char *pow_algorithm,
+	const char *network,
+	const char *genesis_hash
+) {
+	json_t *chain = json_object();
+	json_t *identity = json_object();
+	json_t *explorer = json_object();
+	json_t *shares = json_object();
+	json_t *best = history_default_share("known-history");
+	json_t *since = history_default_share(NULL);
+	const char *explorer_template = history_explorer_template(network);
+
+	if (!chain || !identity || !explorer || !shares || !best || !since) goto fail;
+	json_object_set_new(identity, "pow_algorithm", json_string(pow_algorithm));
+	json_object_set_new(identity, "network", json_string(network));
+	json_object_set_new(identity, "genesis_hash", json_string(genesis_hash));
+	json_object_set_new(explorer, "name", json_string("mempool.guide"));
+	if (explorer_template) {
+		json_object_set_new(explorer, "block_url_template", json_string(explorer_template));
+	} else {
+		json_object_set_new(explorer, "block_url_template", json_null());
+	}
+	json_object_set_new(
+		since,
+		"incomplete_reason",
+		json_string("tracking started without prior post-block share history")
+	);
+	json_object_set_new(shares, "best", best);
+	json_object_set_new(shares, "best_since_last_block", since);
+	json_object_set_new(chain, "identity", identity);
+	json_object_set_new(chain, "explorer", explorer);
+	json_object_set_new(chain, "last_node", json_null());
+	json_object_set_new(chain, "shares", shares);
+	json_object_set_new(chain, "blocks", json_array());
+	return chain;
+
+fail:
+	json_decref(chain);
+	json_decref(identity);
+	json_decref(explorer);
+	json_decref(shares);
+	json_decref(best);
+	json_decref(since);
+	return NULL;
+}
+
+static bool history_rpc_chain_identity(
+	CURL *curl,
+	char network[32],
+	char genesis_hash[65],
+	json_t **chain_info_out
+) {
+	json_t *response;
+	json_t *result;
+	json_t *genesis_response;
+	json_t *genesis_result;
+	const char *network_value;
+	const char *genesis_value;
+
+	response = bitcoind_json_rpc_call(
+		curl,
+		&datum_config,
+		"{\"jsonrpc\":\"1.0\",\"id\":\"datum-history\",\"method\":\"getblockchaininfo\",\"params\":[]}"
+	);
+	if (!response) return false;
+	result = json_object_get(response, "result");
+	network_value = json_string_value(json_object_get(result, "chain"));
+	if (!network_value || strlen(network_value) >= 32) {
+		json_decref(response);
+		return false;
+	}
+
+	genesis_response = bitcoind_json_rpc_call(
+		curl,
+		&datum_config,
+		"{\"jsonrpc\":\"1.0\",\"id\":\"datum-history\",\"method\":\"getblockhash\",\"params\":[0]}"
+	);
+	if (!genesis_response) {
+		json_decref(response);
+		return false;
+	}
+	genesis_result = json_object_get(genesis_response, "result");
+	genesis_value = json_string_value(genesis_result);
+	if (!genesis_value || strlen(genesis_value) != 64) {
+		json_decref(genesis_response);
+		json_decref(response);
+		return false;
+	}
+
+	strcpy(network, network_value);
+	strcpy(genesis_hash, genesis_value);
+	*chain_info_out = json_incref(result);
+	json_decref(genesis_response);
+	json_decref(response);
+	return true;
+}
+
+bool datum_mining_history_select_chain(CURL *curl, const char *pow_algorithm) {
+	char network[32];
+	char genesis_hash[65];
+	char chain_id[160];
+	char timestamp[32];
+	json_t *chain_info = NULL;
+	json_t *chains;
+	json_t *chain;
+	json_t *last_node;
+	json_t *value;
+	const char *tip_hash;
+	bool created = false;
+
+	if (!curl || !pow_algorithm || !pow_algorithm[0]) return false;
+	pthread_mutex_lock(&history_lock);
+	if (history_chain && !strncmp(history_chain_id, pow_algorithm, strlen(pow_algorithm)) &&
+	    history_chain_id[strlen(pow_algorithm)] == ':') {
+		pthread_mutex_unlock(&history_lock);
+		return true;
+	}
+	pthread_mutex_unlock(&history_lock);
+
+	if (!history_rpc_chain_identity(curl, network, genesis_hash, &chain_info)) {
+		DLOG_WARN("Could not identify the node chain for mining history");
+		return false;
+	}
+	if (snprintf(
+		chain_id,
+		sizeof(chain_id),
+		"%s:%s:%s",
+		pow_algorithm,
+		network,
+		genesis_hash
+	) >= (int)sizeof(chain_id)) {
+		json_decref(chain_info);
+		return false;
+	}
+
+	pthread_mutex_lock(&history_lock);
+	history_load_locked();
+	if (!history_root) goto fail;
+	chains = json_object_get(history_root, "chains");
+	chain = json_object_get(chains, chain_id);
+	if (!json_is_object(chain)) {
+		chain = history_create_chain(pow_algorithm, network, genesis_hash);
+		if (!chain) goto fail;
+		json_object_set_new(chains, chain_id, chain);
+		created = true;
+	}
+
+	last_node = json_object();
+	if (!last_node) goto fail;
+	json_object_set_new(
+		last_node,
+		"package_id",
+		datum_config.mining_history_source_node[0]
+			? json_string(datum_config.mining_history_source_node)
+			: json_null()
+	);
+	json_object_set_new(
+		last_node,
+		"observed_at",
+		json_string(history_timestamp((uint64_t)time(NULL), timestamp))
+	);
+	value = json_object_get(chain_info, "blocks");
+	json_object_set_new(
+		last_node,
+		"tip_height",
+		json_is_integer(value) ? json_incref(value) : json_null()
+	);
+	tip_hash = json_string_value(json_object_get(chain_info, "bestblockhash"));
+	json_object_set_new(last_node, "tip_hash", tip_hash ? json_string(tip_hash) : json_null());
+	value = json_object_get(chain_info, "pruned");
+	json_object_set_new(
+		last_node,
+		"pruned",
+		json_is_boolean(value) ? json_incref(value) : json_false()
+	);
+	value = json_object_get(chain_info, "pruneheight");
+	json_object_set_new(
+		last_node,
+		"prune_height",
+		json_is_integer(value) ? json_incref(value) : json_null()
+	);
+	json_object_set_new(chain, "last_node", last_node);
+	json_object_set_new(history_root, "active_chain_id", json_string(chain_id));
+	history_chain = chain;
+	strcpy(history_chain_id, chain_id);
+	history_write_locked();
+	pthread_mutex_unlock(&history_lock);
+	json_decref(chain_info);
+	DLOG_INFO(
+		"Mining history selected %s%s",
+		chain_id,
+		created ? " (new record)" : ""
+	);
+	return true;
+
+fail:
+	pthread_mutex_unlock(&history_lock);
+	json_decref(chain_info);
+	return false;
+}
+
+static json_t *history_share_record_locked(const char *name) {
+	json_t *shares;
+	json_t *record;
+
+	if (!history_chain) return NULL;
+	shares = json_object_get(history_chain, "shares");
+	if (!json_is_object(shares)) {
+		shares = json_object();
+		if (!shares) return NULL;
+		json_object_set_new(history_chain, "shares", shares);
+	}
+	record = json_object_get(shares, name);
+	if (!json_is_object(record)) {
+		record = history_default_share(!strcmp(name, "best") ? "known-history" : NULL);
+		if (!record) return NULL;
+		json_object_set_new(shares, name, record);
+	}
+	return record;
+}
+
+static bool history_update_share_locked(
+	json_t *record,
+	const uint64_t difficulty,
+	const char *share_hash,
+	const char *observed_at
+) {
+	uint64_t current;
+	if (!record) return false;
+	current = history_json_get_u64(json_object_get(record, "difficulty"));
+	if (difficulty <= current) return false;
+	json_object_set_new(record, "difficulty", history_json_u64(difficulty));
+	json_object_set_new(record, "share_hash", json_string(share_hash));
+	json_object_set_new(record, "observed_at", json_string(observed_at));
+	return true;
+}
+
+uint64_t datum_mining_history_best_share(void) {
+	uint64_t difficulty = 0;
+	json_t *record;
+
+	pthread_mutex_lock(&history_lock);
+	record = history_share_record_locked("best");
+	if (record) difficulty = history_json_get_u64(json_object_get(record, "difficulty"));
+	pthread_mutex_unlock(&history_lock);
+	return difficulty;
+}
+
+void datum_mining_history_note_share(
+	const uint64_t difficulty,
+	const uint8_t share_hash[32],
+	const bool include_since_last_block
+) {
+	char hash_hex[65];
+	char timestamp[32];
+	json_t *best;
+	json_t *since;
+	bool changed = false;
+
+	if (!difficulty || !share_hash) return;
+	history_hash_hex(share_hash, hash_hex);
+	history_timestamp((uint64_t)time(NULL), timestamp);
+
+	pthread_mutex_lock(&history_lock);
+	best = history_share_record_locked("best");
+	if (best) changed = history_update_share_locked(best, difficulty, hash_hex, timestamp);
+	if (include_since_last_block) {
+		since = history_share_record_locked("best_since_last_block");
+		if (since && history_update_share_locked(since, difficulty, hash_hex, timestamp)) {
+			changed = true;
+		}
+	}
+	if (changed) history_write_locked();
+	pthread_mutex_unlock(&history_lock);
+}
+
+static bool history_has_block_locked(json_t *blocks, const char *block_hash) {
+	size_t index;
+	json_t *block;
+
+	json_array_foreach(blocks, index, block) {
+		const char *known_hash = json_string_value(json_object_get(block, "hash"));
+		if (known_hash && !strcmp(known_hash, block_hash)) return true;
+	}
+	return false;
+}
+
+bool datum_mining_history_note_block(
+	const char *block_hash,
+	const uint64_t height,
+	const uint64_t block_time,
+	const uint64_t network_difficulty,
+	const uint64_t share_difficulty,
+	const uint64_t reward_sats
+) {
+	char found_at[32];
+	char block_time_text[32];
+	json_t *blocks;
+	json_t *block;
+	json_t *best;
+	json_t *since;
+	bool success;
+
+	if (!block_hash || strlen(block_hash) != 64) return false;
+	history_timestamp((uint64_t)time(NULL), found_at);
+	history_timestamp(block_time, block_time_text);
+
+	pthread_mutex_lock(&history_lock);
+	if (!history_chain) {
+		pthread_mutex_unlock(&history_lock);
+		return false;
+	}
+	blocks = json_object_get(history_chain, "blocks");
+	if (!json_is_array(blocks)) {
+		blocks = json_array();
+		if (!blocks) {
+			pthread_mutex_unlock(&history_lock);
+			return false;
+		}
+		json_object_set_new(history_chain, "blocks", blocks);
+	}
+	if (history_has_block_locked(blocks, block_hash)) {
+		pthread_mutex_unlock(&history_lock);
+		return true;
+	}
+
+	block = json_object();
+	if (!block) {
+		pthread_mutex_unlock(&history_lock);
+		return false;
+	}
+	json_object_set_new(block, "hash", json_string(block_hash));
+	json_object_set_new(block, "height", history_json_u64(height));
+	json_object_set_new(block, "block_time", json_string(block_time_text));
+	json_object_set_new(block, "found_at", json_string(found_at));
+	json_object_set_new(block, "status", json_string("accepted"));
+	json_object_set_new(block, "network_difficulty", history_json_u64(network_difficulty));
+	json_object_set_new(block, "share_difficulty", history_json_u64(share_difficulty));
+	json_object_set_new(block, "reward_sats", history_json_u64(reward_sats));
+	json_object_set_new(block, "payout_address", json_string(datum_config.mining_pool_address));
+	json_object_set_new(
+		block,
+		"coinbase_tags",
+		json_pack(
+			"[s,s]",
+			datum_config.mining_coinbase_tag_primary,
+			datum_config.mining_coinbase_tag_secondary
+		)
+	);
+	json_object_set_new(
+		block,
+		"source_node_package_id",
+		datum_config.mining_history_source_node[0]
+			? json_string(datum_config.mining_history_source_node)
+			: json_null()
+	);
+	json_array_insert_new(blocks, 0, block);
+
+	best = history_share_record_locked("best");
+	if (best) history_update_share_locked(best, share_difficulty, block_hash, found_at);
+	since = history_share_record_locked("best_since_last_block");
+	if (since) {
+		json_object_set_new(since, "difficulty", json_null());
+		json_object_set_new(since, "share_hash", json_null());
+		json_object_set_new(since, "observed_at", json_null());
+		json_object_set_new(since, "reset_at", json_string(found_at));
+		json_object_set_new(since, "reset_by_block_hash", json_string(block_hash));
+		json_object_set_new(since, "complete", json_true());
+		json_object_del(since, "incomplete_reason");
+	}
+	success = history_write_locked();
+	pthread_mutex_unlock(&history_lock);
+	return success;
+}
+
+json_t *datum_mining_history_summary_json(void) {
+	json_t *summary = json_object();
+	json_t *shares;
+	json_t *blocks;
+	json_t *last_block;
+
+	if (!summary) return NULL;
+	pthread_mutex_lock(&history_lock);
+	json_object_set_new(summary, "available", json_boolean(history_chain != NULL));
+	if (!history_chain) {
+		json_object_set_new(summary, "chain_id", json_null());
+		json_object_set_new(summary, "identity", json_null());
+		json_object_set_new(summary, "explorer", json_null());
+		json_object_set_new(summary, "best", json_null());
+		json_object_set_new(summary, "best_since_last_block", json_null());
+		json_object_set_new(summary, "last_block", json_null());
+		pthread_mutex_unlock(&history_lock);
+		return summary;
+	}
+
+	json_object_set_new(summary, "chain_id", json_string(history_chain_id));
+	json_object_set_new(
+		summary,
+		"identity",
+		json_deep_copy(json_object_get(history_chain, "identity"))
+	);
+	json_object_set_new(
+		summary,
+		"explorer",
+		json_deep_copy(json_object_get(history_chain, "explorer"))
+	);
+	shares = json_object_get(history_chain, "shares");
+	json_object_set_new(summary, "best", json_deep_copy(json_object_get(shares, "best")));
+	json_object_set_new(
+		summary,
+		"best_since_last_block",
+		json_deep_copy(json_object_get(shares, "best_since_last_block"))
+	);
+	blocks = json_object_get(history_chain, "blocks");
+	last_block = json_is_array(blocks) ? json_array_get(blocks, 0) : NULL;
+	json_object_set_new(
+		summary,
+		"last_block",
+		last_block ? json_deep_copy(last_block) : json_null()
+	);
+	pthread_mutex_unlock(&history_lock);
+	return summary;
+}
+
+json_t *datum_mining_history_blocks_json(void) {
+	json_t *root = json_object();
+	json_t *blocks;
+
+	if (!root) return NULL;
+	pthread_mutex_lock(&history_lock);
+	json_object_set_new(root, "available", json_boolean(history_chain != NULL));
+	if (!history_chain) {
+		json_object_set_new(root, "chain_id", json_null());
+		json_object_set_new(root, "identity", json_null());
+		json_object_set_new(root, "explorer", json_null());
+		json_object_set_new(root, "blocks", json_array());
+		pthread_mutex_unlock(&history_lock);
+		return root;
+	}
+
+	json_object_set_new(root, "chain_id", json_string(history_chain_id));
+	json_object_set_new(
+		root,
+		"identity",
+		json_deep_copy(json_object_get(history_chain, "identity"))
+	);
+	json_object_set_new(
+		root,
+		"explorer",
+		json_deep_copy(json_object_get(history_chain, "explorer"))
+	);
+	blocks = json_object_get(history_chain, "blocks");
+	json_object_set_new(root, "blocks", json_is_array(blocks) ? json_deep_copy(blocks) : json_array());
+	pthread_mutex_unlock(&history_lock);
+	return root;
+}
