+static int datum_api_send_json(struct MHD_Connection *connection, json_t *root) {
+	char *output;
+	struct MHD_Response *response;
+
+	if (!root) return datum_api_do_error(connection, MHD_HTTP_INTERNAL_SERVER_ERROR);
+	output = json_dumps(root, JSON_COMPACT);
+	json_decref(root);
+	if (!output) return datum_api_do_error(connection, MHD_HTTP_INTERNAL_SERVER_ERROR);
+
+	response = MHD_create_response_from_buffer(strlen(output), output, MHD_RESPMEM_MUST_FREE);
+	if (!response) {
+		free(output);
+		return MHD_NO;
+	}
+	MHD_add_response_header(response, "Content-Type", "application/json");
+	return datum_api_submit_uncached_response(connection, MHD_HTTP_OK, response);
+}
