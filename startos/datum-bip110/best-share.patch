+static uint64_t stratum_share_difficulty(const uint8_t share_hash[32]) {
+	long double hash_value = 0.0L;
+	long double difficulty;
+	int i;
+
+	// Hashes and targets are stored least-significant byte first.  The
+	// difficulty-1 target is 0x00000000ffff0000... in the same 256-bit space.
+	for (i = 31; i >= 0; --i) {
+		hash_value = (hash_value * 256.0L) + (long double)share_hash[i];
+	}
+	if (hash_value == 0.0L) return UINT64_MAX;
+
+	difficulty = (65535.0L * 0x1p208L) / hash_value;
+	if (difficulty >= (long double)UINT64_MAX) return UINT64_MAX;
+	if (difficulty < 0.5L) return 0;
+	return (uint64_t)(difficulty + 0.5L);
+}
+
+static void stratum_atomic_max_u64(uint64_t *value, uint64_t candidate) {
+	uint64_t current = __atomic_load_n(value, __ATOMIC_RELAXED);
+	while (candidate > current &&
+	       !__atomic_compare_exchange_n(value, &current, candidate, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+}
