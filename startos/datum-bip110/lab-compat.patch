+static void datum_lab_headline_tests(void) {
+	T_DATUM_TEMPLATE_DATA template = {0};
+	json_t *gbt = json_pack("{s:{s:s}}", "coinbaseaux", "blake2b_headline", "4249503131302d4c4142");
+	datum_test(datum_gbt_parse_headline(gbt, &template));
+	datum_test(template.blake2b_headline_len == 10);
+	datum_test(!memcmp(template.blake2b_headline, "BIP110-LAB", 10));
+	json_object_set_new(json_object_get(gbt, "coinbaseaux"), "blake2b_headline", json_string("zz"));
+	datum_test(!datum_gbt_parse_headline(gbt, &template));
