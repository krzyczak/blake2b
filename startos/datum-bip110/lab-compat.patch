+static void datum_lab_coinbase_tests(void) {
+	char cb[2048] = {0};
+	int pot;
+	const uint64_t saved_prime_id = datum_config.prime_id;
+	datum_config.prime_id = 0;
+	for (int height = 0; height <= 16; ++height) {
+		datum_test(generate_coinbase_input(height, cb, &pot) > 0);
+		datum_test(hex2bin_uchar(cb) == (height ? 0x50 + height : 0));
+	}
+	const unsigned char headline[] = "BIP110-LAB";
+	int len = generate_coinbase_input_with_headline(20, cb, &pot, headline, sizeof(headline) - 1);
+	datum_test(len > 0 && len <= 100);
+	datum_test(!memcmp(cb + (len - 11) * 2, "0a4249503131302d4c4142", 22));
+	datum_test(hex2bin_uchar(cb + pot * 2) == 0xff);
+	unsigned char longest[90];
+	memset(longest, 'X', sizeof(longest));
+	len = generate_coinbase_input_with_headline(20, cb, &pot, longest, sizeof(longest));
+	datum_test(len == 100);
+	datum_test(!memcmp(cb + 16, "4c5a", 4));
+	datum_test(generate_coinbase_input_with_headline(20, cb, &pot, longest, 91) == -1);
+	datum_test(generate_coinbase_input_with_headline(20, cb, &pot, NULL, 1) == -1);
+	datum_config.prime_id = saved_prime_id;
+}
+
 void datum_coinbaser_tests(void) {
+	datum_lab_coinbase_tests();
+
 	datum_prime_id_64bit_tests();
 	datum_blake2b_coinbase_limit_tests();
 	datum_blake2b_coinbase_sigops_tests();
