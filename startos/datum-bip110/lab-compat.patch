+bool datum_gbt_parse_headline(json_t *gbt, T_DATUM_TEMPLATE_DATA *tdata) {
+	tdata->blake2b_headline_len = 0;
+	json_t *value = json_object_get(json_object_get(gbt, "coinbaseaux"), "blake2b_headline");
+	if (!value) return true;
+	const char *hex = json_string_value(value);
+	const size_t size = json_string_length(value);
+	if (!hex || size % 2 || size > sizeof(tdata->blake2b_headline) * 2 ||
+	    (size && !datum_pow_decode_hex_exact(hex, size / 2, tdata->blake2b_headline))) return false;
+	tdata->blake2b_headline_len = size / 2;
+	return true;
+}
